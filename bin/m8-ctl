#!/usr/bin/env python3
"""
m8-ctl — real control CLI for the Projekt:Alpha execution backend.

Commands talk to the live FastAPI backend (http://127.0.0.1:8000 by default,
override with ALPHA_API_URL). No command fabricates output: when the backend
is offline the command reports that and exits non-zero.

Usage:
  m8-ctl status
  m8-ctl halt            # stop all instances (paper + live shadow)
  m8-ctl resume          # resume paused instances
  m8-ctl cancel-all      # emergency: stop everything + cancel live orders
  m8-ctl sync            # pull real Kraken candles into the lake
  m8-ctl lake            # lake summary
  m8-ctl logs [N]        # last N engine events
"""
import json
import os
import sys
import urllib.request

API = os.environ.get("ALPHA_API_URL", "http://127.0.0.1:8000")


def call(method: str, path: str, body: dict | None = None) -> dict:
    req = urllib.request.Request(
        f"{API}{path}",
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Content-Type": "application/json"},
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return {"ok": False, "http": e.code, "detail": e.read().decode()[:500]}
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "error": str(e)}


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        r = call("GET", "/api/dashboard/init")
        if "status" not in r:
            print(f"backend offline or error: {r}")
            return 1
        print(f"mode:        {r.get('executionMode')}")
        print(f"uptime:      {r.get('uptimeFormatted')}")
        print(f"market feed: {r.get('market_feed')}")
        print(f"credentials: spot={r.get('hasSpotCredentials')} futures={r.get('hasFuturesCredentials')}")
        print(f"instances:   {r.get('activeStrategiesCount')} active / {r.get('totalStrategiesCount')} total")
        print(f"lake rows:   {r.get('lake_rows')}")
        return 0
    if cmd == "halt":
        r = call("POST", "/api/emergency/cancel-all")
        print(json.dumps(r, indent=2))
        return 0 if r.get("ok") or "stoppedInstances" in r else 1
    if cmd == "cancel-all":
        r = call("POST", "/api/emergency/cancel-all")
        print(json.dumps(r, indent=2))
        return 0 if "stoppedInstances" in r else 1
    if cmd == "resume":
        strats = call("GET", "/api/strategies")
        resumed = 0
        for s in strats:
            if s.get("status") == "paused":
                call("POST", f"/api/strategies/{s['id']}/restore")
                resumed += 1
        print(f"resumed {resumed} paused instance(s)")
        return 0
    if cmd == "sync":
        r = call("POST", "/api/lake/sync")
        print(json.dumps(r, indent=2))
        return 0 if r.get("success") else 1
    if cmd == "lake":
        r = call("GET", "/api/lake/summary")
        print(json.dumps(r, indent=2))
        return 0 if "total_rows" in r else 1
    if cmd == "logs":
        n = int(sys.argv[2]) if len(sys.argv) > 2 else 50
        r = call("GET", "/api/logs")
        for ev in r.get("logs", [])[-n:]:
            print(f"[{ev.get('level'):5}] {ev.get('module')}: {ev.get('message')}")
        return 0 if "logs" in r else 1
    print(f"unknown command '{cmd}'. See m8-ctl (no args) for usage.")
    return 2


if __name__ == "__main__":
    sys.exit(main())
