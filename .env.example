# Projekt:Alpha — environment template.
# Copy to .env and fill in. EVERYTHING here is optional: without Kraken keys
# the stack runs in paper mode (live market data, simulated fills).
# Never commit your real .env (it is gitignored).

# ---------------------------------------------------------------- Kraken Spot
# API key needs private-permission for trading endpoints.
# The private key is shown base64-encoded in Kraken account management;
# paste it EXACTLY as shown (the client base64-decodes it for signing).
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_PRIVATE_KEY=
# Legacy aliases (used only if the above are unset):
# KRAKEN_API_KEY=
# KRAKEN_PRIVATE_KEY=

# ---------------------------------------------------------- Kraken Futures Pro
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_PRIVATE_KEY=
# Legacy aliases (used only if the above are unset):
# KRAKEN_PRO_API_KEY=
# KRAKEN_PRO_PRIVATE_KEY=

# ------------------------------------------------------------------- Execution
# paper | live  (live additionally requires a verified passkey session)
ALPHA_EXECUTION_MODE=paper
# Paper-mode starting balance in USD
ALPHA_PAPER_BALANCE=10000
# Base budget per strategy instance in USD (M8 budget multiplier scales this)
ALPHA_BASE_BUDGET=1000

# ----------------------------------------------------------------------- Data
# DuckDB lake location (default: ./data)
# ALPHA_DATA_DIR=./data
# ALPHA_DB_PATH=

# ---------------------------------------------------------------------- WebUI
# WebAuthn relying-party ID (default: localhost)
# ALPHA_RP_ID=localhost
# Comma-separated extra CORS origins
# ALPHA_ALLOWED_ORIGINS=http://localhost:3000
# Session lifetime in seconds (default: 28800)
# ALPHA_SESSION_TTL=28800

# --------------------------------------------------------------------- Market
# Comma-separated symbols tracked at startup
ALPHA_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD
# Candle interval in minutes (default: 60)
# ALPHA_DEFAULT_INTERVAL=60
# Min seconds between market-data polls (default: 5)
# ALPHA_MIN_POLL_SECONDS=5

# ------------------------------------------------------------------- Telegram
# Optional bot notifications (Bot API token + numeric chat id)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -------------------------------------------------------------------- Vite dev
# Proxy target for /api during `npm run dev` (default: http://127.0.0.1:8000)
# VITE_API_PROXY=http://127.0.0.1:8000
# Disable HMR in the dev server (useful inside Docker)
# DISABLE_HMR=true
