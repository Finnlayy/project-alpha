# ==============================================================================
# Projekt:Alpha — Kraken Pro Execution System v2.0
# Environment template.  Copy to `.env` and fill in REAL values only:
#
#     cp .env.example .env
#
# ZERO-DUMMY GUARANTEE: every variable below is OPTIONAL. When a credential is
# absent the system does NOT invent data — it reports an explicit degraded
# state (`offline` / `not_configured`, HTTP 424/503) and refuses the dependent
# operation. Never commit a filled-in `.env`; it is gitignored.
# ==============================================================================

# ---------------------------------------------------------------- Kraken Spot
# Private endpoints use API-Sign =
#   base64(HMAC-SHA512(base64_decode(secret), path + SHA256(nonce + post_data)))
# The private key shown in Kraken account management is base64-encoded; paste
# it verbatim (it is decoded at signing time, never stored decoded).
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_PRIVATE_KEY=
# Legacy aliases (used only if the two above are empty):
# KRAKEN_API_KEY=
# KRAKEN_PRIVATE_KEY=

# ------------------------------------------------------- Kraken Futures (Pro)
# Authent = base64(HMAC-SHA512(base64_decode(secret),
#                              SHA256(postData + nonce + endpointPath)))
# endpointPath excludes the '/derivatives' prefix, e.g. '/api/v3/sendorder'.
# Futures keys are issued separately at futures.kraken.com — Spot keys do not
# grant access to the derivatives API.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_PRIVATE_KEY=
# Legacy aliases (used only if the two above are empty):
# KRAKEN_PRO_API_KEY=
# KRAKEN_PRO_PRIVATE_KEY=

# ------------------------------------------------------------- Execution mode
# 'paper' (default) or 'live'.
# Switching to 'live' at runtime additionally requires a VERIFIED PASSKEY
# session and configured credentials; otherwise the API answers 401/412.
# Paper mode never places a real order; live mode always primes the dead-man
# switch (cancel-after) before dispatching.
ALPHA_EXECUTION_MODE=paper

# ------------------------------------------------------------------- Capital
# Starting balance for the PAPER ledger only (not a claim about real funds).
ALPHA_PAPER_BALANCE=10000
# Per-instance M8 Base Budget (USD). Realized net profit above this budget is
# swept atomically into the DuckDB `vault_ledger`.
# 100 is the blueprint default and the value the M8 thresholds are tuned for
# (THROTTLED at <= 50% of budget, QUARANTINED at <= 0, re-promote at >= 80%).
ALPHA_BASE_BUDGET=100

# -------------------------------------------------------------------- Storage
# DuckDB lake location (defaults to <repo>/data/lake.duckdb).
# ALPHA_DB_PATH=
# ALPHA_DATA_DIR=

# ------------------------------------------------------------- Auth / WebAuthn
# Relying-party ID for FIDO2 passkeys. Must match the domain the UI is served
# from (use 'localhost' for local development).
ALPHA_RP_ID=localhost
# Comma-separated list of allowed WebAuthn origins. Empty = derive from RP id.
ALPHA_ALLOWED_ORIGINS=
# Accept x5c attestation statements (leaf certificate only). Leave false unless
# you explicitly want packed/x5c attestation instead of 'none'.
ALPHA_WEBAUTHN_ALLOW_X5C=false

# --------------------------------------------------------------- Market data
# Comma-separated symbols tracked by the WS v2 feed and the lake ingest.
ALPHA_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD

# ------------------------------------------------------------------- Telegram
# OPTIONAL alerting / 2FA challenge channel. With no token the engine returns
# {"ok": false, "status": "offline", "reason": "UNCONFIGURED_CREDENTIALS"} —
# it never simulates a successful delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBAPP_URL=

# --------------------------------------------------------------- Tooling only
# Backend base URL used by bin/m8-ctl and the MCP server (not read by the app).
# ALPHA_API_URL=http://127.0.0.1:8000
