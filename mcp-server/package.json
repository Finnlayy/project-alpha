{
  "name": "projekt-alpha-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Projekt:Alpha — exposes Kraken trading, quant analytics, backtesting, and strategy orchestration to LLM clients",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/http-server.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2"
  }
}
